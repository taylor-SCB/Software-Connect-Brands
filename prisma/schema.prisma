// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A tenant. Each small business/service provider using the white-labeled
// CRM gets one Organization. Every other model is scoped to an
// organizationId so tenants never see each other's data.
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#4f46e5")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users    User[]
  contacts Contact[]
  deals    Deal[]
  notes    Note[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(OWNER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  notes Note[]

  @@index([organizationId])
}

enum ContactStatus {
  LEAD
  CUSTOMER
  ARCHIVED
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  company        String?
  status         ContactStatus @default(LEAD)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  deals Deal[]
  notes Note[]

  @@index([organizationId])
}

enum DealStage {
  NEW
  CONTACTED
  WON
  LOST
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String
  valueCents     Int          @default(0)
  stage          DealStage    @default(NEW)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([contactId])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([contactId])
}
