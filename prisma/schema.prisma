// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// Where a workspace sits in the operator's approval flow. Signups land in
// PENDING and cannot reach the app; only an approval moves them to ACTIVE.
// PAUSED is the lever for a customer who stops paying — locked out, data
// left completely intact, reversible with one click.
enum OrganizationStatus {
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

// A tenant. Each small business/service provider using the white-labeled
// CRM gets one Organization. Every other model is scoped to an
// organizationId so tenants never see each other's data.
model Organization {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  status             OrganizationStatus @default(PENDING)
  // Set when the operator approves or rejects, for the admin list.
  reviewedAt         DateTime?
  logoUrl            String?
  primaryColor       String             @default("#6366f1")
  // Company Information (Settings → Company Information → General). All
  // optional: a workspace works fine with just a name, and every one of
  // these is a merge field a contract can pull in.
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  phone              String?
  email              String?
  website            String?
  // "About us" and "Company history": plain text, for the website-style
  // blurb a contract or proposal can open with.
  description        String             @default("")
  history            String             @default("")
  // Dates and times render in the business's own zone, everywhere —
  // dashboard, quotes and contracts alike. Storing it per organization
  // keeps server-rendered output deterministic (no hydration mismatch)
  // and means a document shows the sender's local time, not the reader's.
  timeZone           String             @default("America/Chicago")
  // Money is stored in cents everywhere; these drive human-readable
  // sequential document numbers (QUO-1004, CON-1002...).
  nextQuoteNumber    Int                @default(1000)
  nextContractNumber Int                @default(1000)
  // The Preset Payment Table (Settings → Company Information → General):
  // what a new contract's payment table starts as. The preset uses the
  // same identifiers the tracker's preset picker does (see
  // SchedulePreset in src/lib/payments.ts); the percent and count only
  // matter for the preset that needs them.
  defaultPaymentTerms     String        @default("Net 30")
  defaultPaymentPreset    String        @default("FULL")
  defaultDepositPercent   Int           @default(50)
  defaultInstallmentCount Int           @default(3)
  // PRJ-n on an awarded project, allocated like the quote and contract
  // numbers above.
  nextProjectNumber       Int           @default(1000)
  // INV-n, stamped on a payment row when it is sent as an invoice.
  nextInvoiceNumber       Int           @default(1000)
  // "Checks to Acme LLC, 12 Main St. Zelle: pay@acme.com" — printed on
  // the invoice a customer opens, since nothing here takes card payments.
  paymentInstructions     String        @default("")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users               User[]
  companies           Company[]
  contacts            Contact[]
  deals               Deal[]
  notes               Note[]
  activities          Activity[]
  products            Product[]
  quotes              Quote[]
  contractTypeOptions ContractTypeOption[]
  industryOptions     IndustryOption[]
  companyTypeOptions  CompanyTypeOption[]
  contractTemplates   ContractTemplate[]
  contracts           Contract[]
  manufacturers       Manufacturer[]
  distributors        Distributor[]
  distributorContacts DistributorContact[]
  ratesheets          Ratesheet[]
  ratesheetInvites    RatesheetInvite[]
  linkedRatesheets    LinkedRatesheet[]
  uploads             Upload[]
  payments            Payment[]
  serviceTypeOptions  ServiceTypeOption[]
  projects            Project[]
  crews               Crew[]
  workers             Worker[]
  timeEntries         TimeEntry[]
  eventTypeOptions    EventTypeOption[]
  calendarEvents      CalendarEvent[]
  projectTasks        ProjectTask[]
  properties          Property[]

  @@index([status])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                   String       @id @default(cuid())
  name                 String
  email                String       @unique
  // No email is sent anywhere yet, so a phone number is the only way to
  // tell an applicant they were approved.
  phone                String?
  // My Account: job title on the company's user list and on documents
  // this person signs.
  title                String?
  // Shown next to the name in the sidebar and on the Company Users tile.
  // A path under /files/ when uploaded here.
  avatarUrl            String?
  // No in-app messaging exists yet; the switch is stored so the preference
  // is already set when it does.
  receiveInAppMessages Boolean      @default(true)
  passwordHash         String
  role                 Role         @default(OWNER)
  // Operator-level access to every workspace. Deliberately has no path
  // through the UI or any form — it is set with scripts/promote-admin.ts
  // against the database, so no request can grant it to itself.
  isSuperAdmin         Boolean      @default(false)
  lastLoginAt          DateTime?
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())

  notes      Note[]
  activities Activity[]
  uploads    Upload[]
  // Quotes this person leads or signs. Both SetNull, unlike the three
  // above — a quote must outlive the person who owned it.
  leadQuotes   Quote[] @relation("QuoteLeadRep")
  signerQuotes Quote[] @relation("QuoteContractSigner")

  @@index([organizationId])
}

// Shared by contacts and companies: a lead is someone you are chasing, a
// customer is someone who has bought, archived is out of the way but kept.
enum ContactStatus {
  LEAD
  CUSTOMER
  ARCHIVED
}

// A business the workspace sells to. Contacts are the people at it; a
// residential customer is a contact with no company at all, which is why
// nothing downstream (deals, quotes, contracts) ever requires one.
model Company {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  website        String?
  city           String?
  state          String?
  // Their logo, shown on the deal tracker and on the documents sent to
  // them. A path under /files/ when uploaded here.
  logoUrl        String?
  // What kind of business it is, and what role it plays in that world:
  // both multi-select, both stored as the pick-list names (like a
  // contract's type) so a renamed option is a label change, not a
  // migration. The lists live in IndustryOption / CompanyTypeOption.
  industries     String[]      @default([])
  companyTypes   String[]      @default([])
  // The yellow star. One flag per workspace, since a workspace has one
  // user today; "Favorite Companies" in the sidebar is this filter.
  favorite       Boolean       @default(false)
  status         ContactStatus @default(LEAD)
  // Fields the app filled in on its own from the spreadsheet and the
  // company's own people ('industries', 'companyTypes', 'phone',
  // 'website'; see src/lib/enrich.ts). Each shows a small "auto" mark
  // until a person edits that field or presses "Looks right", which
  // clears it. enrichedAt is when the app last filled something in.
  autoFilled     String[]      @default([])
  enrichedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contacts    Contact[]
  notes       Note[]
  activities  Activity[]
  uploads     Upload[]
  contracts   Contract[]
  projects    Project[]
  distributor Distributor?
  crews       Crew[]
  events      CalendarEvent[]
  properties  Property[]
  // Quote lines we buy from this company. Internal to the workspace.
  supplierQuoteLines QuoteLineItem[] @relation("QuoteLineSupplier")

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, updatedAt])
  @@index([organizationId, state])
  @@index([organizationId, favorite])
  @@index([industries], type: Gin)
  @@index([companyTypes], type: Gin)
  // No index on autoFilled: the "Auto-filled" toggle asks for a non-empty
  // list (`<> '{}'`), which a GIN index cannot serve, and the
  // organizationId index already narrows it enough.
  // Trigram indexes behind the list search (ILIKE '%text%'); pg_trgm is
  // declared on the datasource above so migrate dev keeps them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_phone_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_city_trgm_idx")
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name           String
  // Their job title at the company: Owner, Office Manager, Foreman.
  title          String?
  email          String?
  phone          String?
  website        String?
  city           String?
  state          String?
  // The one personal fact stored as a real date rather than a note, so a
  // reminder can be built on it later.
  birthday       DateTime?     @db.Date
  // A photo or icon for the person. A path under /files/ when uploaded.
  imageUrl       String?
  // The yellow star; see Company.favorite.
  favorite       Boolean       @default(false)
  status         ContactStatus @default(LEAD)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  deals      Deal[]
  notes      Note[]
  activities Activity[]
  quotes     Quote[]
  contracts  Contract[]
  uploads    Upload[]
  projects   Project[]
  crews      Crew[]
  events     CalendarEvent[]
  properties Property[]
  // Events this person is expected at, as distinct from the one they are
  // the point of contact for above.
  attending  CalendarEvent[] @relation("EventAttendees")

  @@index([organizationId])
  @@index([companyId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, state])
  @@index([organizationId, favorite])
  @@index([organizationId, email])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phone_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_city_trgm_idx")
}

// A deal is one job you are trying to win. It moves through the pipeline
// as the paperwork goes out: sending a quote or a contract advances it,
// and a signed contract wins it. It never moves backwards on its own.
enum DealStage {
  LEAD
  CONTACTED
  QUOTE_SENT
  CONTRACT_SENT
  WON
  LOST
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String
  // The typed estimate. Only counts until a quote exists; from then on
  // the deal's value is read from its quotes (see src/lib/deals.ts).
  valueCents     Int          @default(0)
  stage          DealStage    @default(LEAD)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quotes    Quote[]
  contracts Contract[]
  project   Project?
  events    CalendarEvent[]

  @@index([organizationId])
  @@index([contactId])
}

// Labels a note can wear. The personal ones (everything but GENERAL) are
// what the contact page gathers into its relationship view.
enum NoteLabel {
  GENERAL
  PERSONAL
  BIRTHDAY
  HOBBIES
  FAMILY
}

// A note sits on a contact or on a company, never both and never neither.
// batchId ties together the copies made when one note is logged against
// several contacts at once.
model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // A note can be about a job rather than a person: "owner wants the
  // north side done first". Kept on the job so it survives the contact
  // moving on.
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  label          NoteLabel?
  batchId        String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([projectId])
  @@index([batchId])
}

// Touchpoints with a contact or a company. Each type is counted
// separately in the contacts list so reps can see engagement at a glance.
enum ActivityType {
  TEXT
  EMAIL
  PHONE_CALL
  MEETING
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ActivityType
  body           String
  batchId        String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([contactId, type])
  @@index([companyId])
  @@index([projectId])
  @@index([batchId])
}

// Every quote line must carry one of these so the tag totals grid at the
// bottom of a quote adds up to the quote total.
enum LineItemTag {
  LABOR
  MATERIALS
  SOFTWARE
  PROJECT_SERVICES
  SHIPPING
  TAXES
}

model Product {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  description         String               @default("")
  sku                 String?
  unitPriceCents      Int                  @default(0)
  // Cost of goods sold. Internal only — never rendered on anything a
  // customer or partner can open.
  costCents           Int                  @default(0)
  defaultTag          LineItemTag          @default(MATERIALS)
  // The kind of work this is sold under ("Access Control", "Painting"),
  // by name from the workspace's ServiceTypeOption list. Copied onto a
  // quote row when the product is added, which is what lets a won job
  // split its budget by scope without anyone typing it twice.
  serviceType         String?
  unitOfMeasure       UnitOfMeasure?
  // Software is priced per unit per period: the rate is the period and the
  // term is how many of them. Both are null unless the unit is a software
  // unit.
  softwareRate        SoftwareRate?
  softwareTerm        Int?
  manufacturerId      String?
  manufacturer        Manufacturer?        @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  distributorId       String?
  distributor         Distributor?         @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  distributorContacts DistributorContact[]
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lineItems      QuoteLineItem[]
  ratesheetItems RatesheetItem[]

  @@index([organizationId])
  @@index([manufacturerId])
  @@index([distributorId])
}

enum QuoteTemplate {
  SIMPLE
  MODERN
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // Every quote is an offer on a deal; a deal can carry several.
  dealId         String
  deal           Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  number         Int
  title          String
  template       QuoteTemplate @default(SIMPLE)
  status         QuoteStatus   @default(DRAFT)
  introNote      String        @default("")
  terms          String        @default("")
  // The one-line terms shown above the payment table ("Net 30"), as
  // Contract.paymentTerms is. The free-text `terms` above stays the fine
  // print and is still what {{quote_terms}} merges into a contract body.
  paymentTerms   String?
  // Ticked to keep the payment table off the customer's copy. Honoured in
  // the query that builds that copy, not in CSS: hiding it in the browser
  // would still ship the numbers inside the page.
  hidePaymentTable Boolean     @default(false)
  // Who owns the deal, who signs it, and who else is on it. All three are
  // SetNull on purpose: every other User relation in this file cascades,
  // and cascading here would delete the quote along with the person.
  leadSalesRepId   String?
  leadSalesRep     User?       @relation("QuoteLeadRep", fields: [leadSalesRepId], references: [id], onDelete: SetNull)
  contractSignerId String?
  contractSigner   User?       @relation("QuoteContractSigner", fields: [contractSignerId], references: [id], onDelete: SetNull)
  // Ids of other workspace users on this deal. A plain array rather than
  // a join table so updateQuoteMeta can keep writing through updateMany
  // with organizationId in the WHERE clause.
  teamUserIds      String[]    @default([])
  validUntil     DateTime?
  publicToken    String        @unique
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lineItems QuoteLineItem[]
  payments  QuotePayment[]
  contracts Contract[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([leadSalesRepId])
  @@index([contractSignerId])
}

model QuoteLineItem {
  id             String      @id @default(cuid())
  quoteId        String
  quote          Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Copied from the product at insert time so editing a product later
  // never rewrites history on a quote that was already sent.
  name           String
  description    String      @default("")
  projectNotes   String      @default("")
  quantity       Float       @default(1)
  unitPriceCents Int         @default(0)
  tag            LineItemTag
  // Who we buy this line from. Internal: never selected onto the public
  // quote page, the PDF taken from it, or the text merged into a contract
  // body — the same footing as what a line costs us.
  supplierCompanyId String?
  supplierCompany   Company? @relation("QuoteLineSupplier", fields: [supplierCompanyId], references: [id], onDelete: SetNull)
  // How the line is counted, and for a software line how it bills and for
  // how long. Descriptive: the term is printed beside the line and never
  // multiplies the line total, which stays quantity × price.
  unitOfMeasure  UnitOfMeasure?
  softwareRate   SoftwareRate?
  // Plain months, unlike Product.softwareTerm which counts periods of
  // whatever softwareRate says. Typed as years + months and stored flat.
  softwareTermMonths Int?
  // Optional: which kind of work this row belongs to, from the
  // workspace's service-type list. Only shown once "Split by service
  // type" is turned on, so a one-trade business never sees it.
  serviceType    String?
  position       Int         @default(0)
  // Set from the deal tracker when a row is taken off the table without
  // deleting it from the quote: it stays on the quote, priced, but can
  // no longer be put on a contract. Cleared by "Restore".
  cancelledAt    DateTime?

  contractLines ContractLineItem[]

  @@index([quoteId])
  @@index([supplierCompanyId])
}

// What the customer is asked to pay and when. Deliberately NOT a copy of
// ContractPayment: no paidAt, no invoice number or token, no Payment
// children. A quote is a promise and a contract is money — nothing should
// be able to record a payment against a quote, and none of the owed
// figures in src/lib/money.ts can ever see one of these rows.
model QuotePayment {
  id             String      @id @default(cuid())
  quoteId        String
  quote          Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // Carried so a row can be looked up with the workspace in the WHERE
  // clause, exactly as ContractPayment does.
  organizationId String?
  label          String
  kind           PaymentKind @default(PERCENT)
  // Whole percent for PERCENT rows (50 = 50%); unused otherwise.
  percent        Float?
  amountCents    Int         @default(0)
  dueOn          DateTime?   @db.Date
  // "Net 30", "Upon Signature". What the Due cell prints when no date has
  // been picked; a picked date wins and is printed as-is.
  terms          String?
  position       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([quoteId])
  @@index([organizationId])
}

// The pick list behind a template's "Type" (Service Agreement, Change
// Order, mNDA, Commission Agreement...). Per workspace, extended inline
// from the template form with "+ Add new type", so nobody is stuck with
// the three a new workspace starts with.
model ContractTypeOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

// The Industry pick list a company (and, through its company, a contact)
// is tagged with: MDU, Student, Commercial... seeded per workspace from
// DEFAULT_INDUSTRIES and extended by "+ Add new industry" on the forms.
model IndustryOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  companyTypes CompanyTypeOption[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// The Company Type choices under one industry: Owner, Developer and
// Property Management under MDU; Integrator or Electrician under Service
// Provider; "General" wherever nothing more specific exists yet.
model CompanyTypeOption {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryId     String
  industry       IndustryOption @relation(fields: [industryId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())

  @@unique([industryId, name])
  @@index([organizationId])
}

model ContractTemplate {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  // The type's name as picked from ContractTypeOption. Stored as text, not
  // a foreign key: it is a label on the document, and a template must keep
  // reading the same after its type is renamed or removed from the list.
  type            String       @default("Custom")
  description     String       @default("")
  body            String
  // Who can send a contract made from this template. Everyone by default;
  // switching allUsersCanSend off limits it to senderUserIds. The list is
  // kept when the switch is turned back on, so it survives a toggle.
  allUsersCanSend Boolean      @default(true)
  senderUserIds   String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contracts Contract[]

  @@index([organizationId])
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  // Withdrawn by the workspace, from the deal tracker. Its line items go
  // back to "open" on the deal so they can be sent again.
  CANCELLED
}

// How one row of a payment schedule is sized. PERCENT and FIXED are what
// they say; BALANCE is "whatever is left", so the schedule always adds up
// to the contract total even after rounding.
enum PaymentKind {
  PERCENT
  FIXED
  BALANCE
}

model Contract {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // The business this document is addressed to. Usually the contact's
  // company; a purchase order split off a deal goes to the supplier's
  // company instead, which is why it is stored here and not derived.
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Optional: a standalone service agreement has no deal behind it.
  dealId           String?
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  templateId       String?
  template         ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // The quote whose numbers filled the merge fields, when the deal had one.
  quoteId          String?
  quote            Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  number           Int
  title            String
  type             String            @default("Custom")
  // Merge fields are resolved when the contract is created, so the
  // signed copy is a frozen snapshot of what the customer agreed to.
  body             String
  status           ContractStatus    @default(DRAFT)
  // Which way the money goes. false = they owe us (a Sales Order, Service
  // Agreement, Change Order or Invoice: "Money in"); true = we owe them (a
  // Purchase Order to a supplier: "Money out"). Defaults from the
  // template's type, and the user can flip it. Only Money-in contracts
  // count as money owed to the business, and only their signature wins a
  // deal — a supplier signing a PO is not the customer saying yes.
  payable          Boolean           @default(false)
  // The awarded job this paperwork belongs to: the signed agreement that
  // created it, and every purchase order and change order since.
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // A change order says which agreement it changes. Shown on both, so
  // neither reads as a stray document; the budget math works off the
  // rows, not this link.
  amendsContractId String?
  amends           Contract?         @relation("Amends", fields: [amendsContractId], references: [id], onDelete: SetNull)
  amendedBy        Contract[]        @relation("Amends")
  publicToken      String            @unique
  sentAt           DateTime?
  signedAt         DateTime?
  signerName       String?
  signerEmail      String?
  // "Mark signed": the customer signed a paper copy, or said yes some
  // other way, and the user recorded it by hand instead of through the
  // signing link. The note is their own words ("signed on site").
  signedOffline    Boolean           @default(false)
  signedNote       String?
  declinedAt       DateTime?
  cancelledAt      DateTime?
  // "Your Company Signer": who signs for the workspace. Prefilled with the
  // owner's name on the deal tracker; printed under the provider's
  // signature line.
  senderSignerName String?
  // "Net 30", "Due on receipt"... free text so a workspace can write its
  // own. The dated rows live in `payments`.
  paymentTerms     String?
  // Set when this contract's payment rows were seeded from its quote's
  // table rather than from a preset, and when someone first changed them
  // afterwards. Together they are what puts "Amended from original quote"
  // on the schedule, so the difference from what the customer was quoted
  // is visible rather than silent.
  scheduleFromQuote Boolean          @default(false)
  scheduleAmendedAt DateTime?
  // Reminders are copied out by hand today (no email is sent). Counting
  // them is what lets the tracker say "reminded twice, last on Sep 12".
  reminderCount    Int               @default(0)
  lastReminderAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lineItems ContractLineItem[]
  payments  ContractPayment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, payable, status])
  @@index([projectId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([quoteId])
}

// A quote row that was put on this contract by the deal tracker. Copied,
// like a quote line copies its product, so the contract keeps reading the
// same after the quote is edited; quoteLineItemId is what lets the
// tracker label the quote's row "Sent" or "Signed".
model ContractLineItem {
  id              String         @id @default(cuid())
  contractId      String
  contract        Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  quoteLineItemId String?
  quoteLineItem   QuoteLineItem? @relation(fields: [quoteLineItemId], references: [id], onDelete: SetNull)
  name            String
  description     String         @default("")
  quantity        Float          @default(1)
  unitPriceCents  Int            @default(0)
  tag             LineItemTag
  // Copied from the quote row, like the tag is, so the contract keeps
  // reading the same after the quote is edited.
  serviceType     String?
  // What the product cost at the moment this row was put on the contract.
  // Owner-only: it is what the job is expected to cost, never printed on
  // anything a customer or partner can open. Null when there was no
  // product behind the row, or no cost on file.
  unitCostCents   Int?
  // Which scope of the project this row's money belongs to. Set when the
  // job is awarded, and movable afterwards from the Budget page.
  scopeId         String?
  scope           ProjectScope?  @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  position        Int            @default(0)

  @@index([contractId])
  @@index([quoteLineItemId])
  @@index([scopeId])
}

// One row of a contract's payment schedule: "50% deposit, due Sep 15".
// amountCents is recomputed from the contract total whenever the schedule
// is saved, so the stored number is always what the row was worth when
// the customer last saw it.
model ContractPayment {
  id             String      @id @default(cuid())
  contractId     String
  contract       Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // Copied from the contract so a payment row can be looked up with the
  // workspace in the WHERE clause. Nullable only because it was added
  // after the table existed; the migration backfilled every row and every
  // write since sets it.
  organizationId String?
  label          String
  kind           PaymentKind @default(PERCENT)
  // Whole percent for PERCENT rows (50 = 50%); unused otherwise.
  percent        Float?
  amountCents    Int         @default(0)
  dueOn          DateTime?   @db.Date
  // "Net 30", "Upon Signature". What the Due cell prints when no date has
  // been picked. Purely a label: dueOn keeps its exact meaning, because
  // the owed and overdue figures in src/lib/money.ts read it in raw SQL.
  terms          String?
  // When the row was settled: set the moment the payments recorded on it
  // add up to amountCents, cleared when a payment is removed below that.
  // Written only by settleRow in src/lib/money.ts, never by hand.
  paidAt         DateTime?
  position       Int         @default(0)
  // Sending a row as an invoice stamps it: INV-n, a link the customer can
  // open without a login, and when it went out. A row with no number is
  // still owed — it is just on the signed agreement rather than on an
  // invoice of its own.
  invoiceNumber  Int?
  invoiceToken   String?     @unique
  issuedAt       DateTime?
  // Their invoice or check number on a bill from a supplier.
  reference      String?

  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([contractId])
  @@index([organizationId])
}

// Money that actually came in (or went out) against one row of a payment
// table: "$600 by check on Sep 12, ref 1042". A row can carry several,
// which is how a partial payment is recorded; the row is settled when
// they add up to its amount. Ticking "Paid" records one for the balance.
model Payment {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractPaymentId String
  contractPayment   ContractPayment @relation(fields: [contractPaymentId], references: [id], onDelete: Cascade)
  amountCents       Int
  // The day the money moved, as a calendar date in the workspace's zone.
  paidOn            DateTime        @db.Date
  // "Check", "ACH", "Zelle"... free text with suggestions; null when the
  // row was simply ticked Paid.
  method            String?
  // Check number, transaction id — whatever helps find it again.
  reference         String?
  note              String?
  createdAt         DateTime        @default(now())

  @@index([contractPaymentId])
  @@index([organizationId, paidOn])
}

// ------------------------------------------------------------------
// Product catalog lookups
// ------------------------------------------------------------------

// Each list belongs to the tag it is named after (see UNIT_GROUPS in
// src/lib/constants.ts); the form and the save action both enforce it.
// Kept as one enum so a product carries exactly one unit whatever its tag.
enum UnitOfMeasure {
  PER_HOUR
  PER_DAY
  PER_PERSON_PER_HOUR
  PER_PERSON_PER_DAY
  PER_ROOM
  PER_BUILDING
  PER_PROPERTY
  EACH
  PER_PIECE
  PER_SQFT
  PER_LINEAR_FT
  PER_CUBIC_YARD
  PER_ITEM
  PER_GALLON
  PER_POUND
  PER_UNIT
  PER_BED
  PER_LOCATION
  PER_DEVICE
}

enum SoftwareRate {
  PER_MONTH
  PER_YEAR
  PER_TERM
}

// OEM / manufacturer pick list. Per workspace, created inline from the
// product form, so a new tenant is never staring at an empty dropdown.
model Manufacturer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Distributor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // The company a purchase order to this distributor is addressed to.
  // Made the first time materials are ordered from them, so the money
  // owed to them lands on one record rather than two.
  companyId      String?      @unique
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts DistributorContact[]
  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A person at a distributor. A product can point at several of them (the
// rep, the inside sales desk, the branch manager), hence the many-to-many
// from Product.
model DistributorContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  distributorId  String
  distributor    Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())

  products Product[]

  @@index([organizationId])
  @@index([distributorId])
}

// ------------------------------------------------------------------
// Ratesheets
// ------------------------------------------------------------------

// PUBLIC: anyone in the system can find and link it until it expires.
// INVITE_APPROVE: findable, but linking sends the owner a request to
// approve or decline. PARTNER_SPECIFIC: sent to one email address, which
// approves or declines it.
enum RatesheetVisibility {
  PUBLIC
  INVITE_APPROVE
  PARTNER_SPECIFIC
}

enum RatesheetInviteStatus {
  PENDING
  APPROVED
  DECLINED
}

// A named, shareable selection of a workspace's own products. Items point
// at live products rather than copying them: a ratesheet is a price list,
// and a price list that silently goes stale is worse than none.
model Ratesheet {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  visibility        RatesheetVisibility @default(PUBLIC)
  // After this date nobody can select or answer it.
  expiresOn         DateTime?
  // Days a partner has to approve or decline once sent. Null for PUBLIC,
  // which is simply open until it expires.
  respondWithinDays Int?
  active            Boolean             @default(true)
  publicToken       String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items   RatesheetItem[]
  invites RatesheetInvite[]

  @@index([organizationId])
  @@index([visibility, active])
}

model RatesheetItem {
  id          String    @id @default(cuid())
  ratesheetId String
  ratesheet   Ratesheet @relation(fields: [ratesheetId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position    Int       @default(0)

  @@unique([ratesheetId, productId])
  @@index([ratesheetId])
  @@index([productId])
}

// One send of a ratesheet to one partner. The token is the only auth on
// the partner's approve/decline page, so it carries real entropy.
model RatesheetInvite {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ratesheetId    String
  ratesheet      Ratesheet             @relation(fields: [ratesheetId], references: [id], onDelete: Cascade)
  partnerEmail   String
  partnerName    String?
  token          String                @unique
  status         RatesheetInviteStatus @default(PENDING)
  sentAt         DateTime              @default(now())
  // sentAt + the ratesheet's respondWithinDays. Null means no deadline.
  respondBy      DateTime?
  respondedAt    DateTime?
  createdAt      DateTime              @default(now())

  @@index([organizationId, status])
  @@index([ratesheetId])
}

// A ratesheet file the user uploaded (a distributor's price list). The
// bytes live in Postgres because that is the one store this app has; the
// action caps uploads at 4 MB so the table can't balloon.
model LinkedRatesheet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  fileName       String
  mimeType       String
  sizeBytes      Int
  // Excluded from every query by default (see src/lib/prisma.ts) so a
  // list page never drags megabytes through the server; only the download
  // route asks for it.
  data           Bytes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ------------------------------------------------------------------
// Uploads
// ------------------------------------------------------------------

// What an uploaded file is for. The image kinds are served without a
// login (a logo has to load on the customer's copy of a contract); the
// document kinds are only ever streamed back to the workspace that owns
// them.
enum UploadKind {
  ORG_LOGO
  USER_AVATAR
  COMPANY_LOGO
  CONTACT_IMAGE
  COMPLIANCE
  MARKETING
  // Anything that belongs to a job: a photo from site, a receipt, or the
  // other party's own contract when theirs was the paper that got signed.
  PROJECT_FILE
}

// Any file a workspace uploads: logos, avatars, W-9s, brochures. Bytes
// live in Postgres like LinkedRatesheet (4 MB cap in the action) and the
// column is omitted from every query by default (src/lib/prisma.ts).
// `publicToken` is the file's address under /files/, so a logo's URL is
// unguessable and changes every time the logo is replaced.
model Upload {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           UploadKind
  // "W-9", "COI", "License" on a compliance file; free on marketing.
  category       String?
  name           String
  fileName       String
  mimeType       String
  sizeBytes      Int
  data           Bytes
  publicToken    String       @unique
  // When a COI or license runs out, so the compliance tile can flag it.
  expiresOn      DateTime?    @db.Date
  // Which record an image belongs to; null for workspace-level files.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, kind])
  @@index([projectId])
  @@index([userId])
  @@index([companyId])
  @@index([contactId])
}

// ------------------------------------------------------------------
// Projects and budgets
// ------------------------------------------------------------------

// The kinds of work a business sells: Painting, Roofing, Access Control.
// A per-workspace pick list like ContractTypeOption, seeded from
// SERVICE_TYPE_DEFAULTS the first time a form asks for it and extended
// by "+ Add new service type". Stored by name wherever it is used, so a
// renamed option is a label change rather than a migration.
model ServiceTypeOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Where a won job stands. AWARDED is signed but nothing scheduled;
// ACTIVE flips on by itself the first time work is dated or hours are
// logged. ON_HOLD reads "Delayed" on screen — Taylor's word for it.
enum ProjectStage {
  AWARDED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// A job that was won. One per deal, created the moment the customer
// signs (or when the user records a signature by hand), already carrying
// the budget the signed contract set.
model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  name           String
  stage          ProjectStage @default(AWARDED)
  // The deal it came from. One project per deal; null once the deal is
  // deleted, which is why the customer's name is copied below.
  dealId         String?      @unique
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // "Harbor Property Group · Dana Ruiz" — kept as text so the row still
  // reads after a company or contact is deleted.
  customerName   String
  // The building the work is at, when several jobs share one. A job has at
  // most one property, which is what keeps a property's roll-up from
  // counting the same money twice.
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // Where the work happens, which is often not the customer's office. One
  // free line; nothing else in the app stores a job-site address.
  siteAddress    String?
  awardedAt      DateTime
  // True when the award came from "Mark signed" or "Award without
  // paperwork" rather than the customer signing the link.
  awardedOffline Boolean      @default(false)
  // The first dated day of work, which is what flips the stage to ACTIVE.
  startOn        DateTime?    @db.Date
  closedAt       DateTime?
  closeOutNote   String?
  // The bar's four numbers, kept on the row so the list and the roll-ups
  // read them without adding every line item up again. Recomputed from
  // scratch by refreshProjectTotals after anything that moves money, and
  // by `npm run recompute-projects` if they are ever doubted.
  awardedCents     Int        @default(0)
  spentCents       Int        @default(0)
  committedCents   Int        @default(0)
  receivedCents    Int        @default(0)
  billedCents      Int        @default(0)
  plannedCostCents Int        @default(0)
  // The crew-time part of spent and committed, summed from its scopes.
  laborSpentCents     Int     @default(0)
  laborCommittedCents Int     @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scopes      ProjectScope[]
  contracts   Contract[]
  uploads     Upload[]
  timeEntries TimeEntry[]
  events      CalendarEvent[]
  tasks       ProjectTask[]
  notes       Note[]
  activities  Activity[]

  @@unique([organizationId, number])
  @@index([organizationId, stage])
  @@index([organizationId, updatedAt])
  @@index([companyId])
  @@index([contactId])
  @@index([propertyId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Project_name_trgm_idx")
}

// One scope of work inside a project: the smart-lock half and the
// access-control half of the same job, each with its own bar, crew and
// change orders. Every project has a default scope ("Whole job") that
// holds anything untagged; when it is the only one the page shows a
// single bar and never mentions scopes at all.
model ProjectScope {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  // The service type this scope covers, by name; null on the default one.
  serviceType String?
  // The scope of work in the owner's own words.
  description String   @default("")
  // Who is doing it. The crew picked from the workspace's own list, or a
  // typed name when there is no crew record — the field predates crews and
  // still reads for a one-off sub nobody wants to set up.
  crewId      String?
  crew        Crew?    @relation(fields: [crewId], references: [id], onDelete: SetNull)
  crewLabel   String?
  isDefault   Boolean  @default(false)
  position    Int      @default(0)
  // The same six numbers as the project, for this scope alone. The
  // project's are the sum of its scopes', so the two can never disagree.
  awardedCents     Int @default(0)
  spentCents       Int @default(0)
  committedCents   Int @default(0)
  receivedCents    Int @default(0)
  billedCents      Int @default(0)
  plannedCostCents Int @default(0)
  // The part of spent and committed that is crew time rather than
  // materials, so the bar can be explained without adding hours up again.
  laborSpentCents     Int @default(0)
  laborCommittedCents Int @default(0)

  awards      ScopeAward[]
  lineItems   ContractLineItem[]
  timeEntries TimeEntry[]
  events      CalendarEvent[]

  @@index([projectId])
  @@index([crewId])
}

// Why a scope's awarded amount is what it is. CONTRACT is the signed
// agreement that started it, CHANGE_ORDER a signed change up or down,
// CONTRACT_REMOVED the reversal when signed paperwork is deleted, QUOTE
// the fallback for an agreement with no priced rows, and MANUAL an
// adjustment someone typed with a reason. Rows are never edited, so the
// history under the bar always explains the number above it.
enum AwardKind {
  CONTRACT
  CHANGE_ORDER
  CONTRACT_REMOVED
  QUOTE
  MANUAL
}

model ScopeAward {
  id         String       @id @default(cuid())
  scopeId    String
  scope      ProjectScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  kind       AwardKind
  // Positive for an award or an addition, negative for a credit or a
  // reversal. The scope's awarded total is the sum of these.
  deltaCents Int
  // The paperwork that produced it, when there was some. Together with
  // the kind this is what makes re-awarding the same contract a no-op.
  contractId String?
  note       String       @default("")
  createdAt  DateTime     @default(now())

  @@index([scopeId])
  @@index([contractId])
}

// Who does the work. Two kinds, and the difference is entirely about
// money: your OWN people cost you their hours, so their time lands in the
// job's Spent. A SUBCONTRACTOR is another company that bills you, so
// their money arrives as their purchase order and their hours are tracked
// for the schedule and for checking that bill — never counted twice.
enum CrewKind {
  OWN
  SUBCONTRACTOR
}

// A crew is a named group you send to a job: "Install Team A", or
// "Ridgeline Roofing" as a subcontractor. Built once, assigned to scopes
// of work on any number of jobs.
model Crew {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           CrewKind     @default(OWN)
  // The company that bills you, on a subcontractor crew. Their record in
  // the CRM, so what is owed to them reads on one page.
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Who you call: their foreman or coordinator.
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // What they do, by service-type name, so a scope suggests the right crew.
  serviceTypes   String[]     @default([])
  // What they cost. Either rate, or both: a crew quoted by the day still
  // gets called out for four hours sometimes.
  hourlyRateCents Int?
  dailyRateCents  Int?
  phone          String?
  email          String?
  notes          String       @default("")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workers     Worker[]
  timeEntries TimeEntry[]
  scopes      ProjectScope[]
  events      CalendarEvent[]

  @@index([organizationId, active])
  @@index([companyId])
  @@index([contactId])
}

// One person on a crew. Their own rate when they have one, else the
// crew's. Not a login — nobody here can sign in.
model Worker {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crewId         String?
  crew           Crew?        @relation(fields: [crewId], references: [id], onDelete: SetNull)
  name           String
  // "Journeyman electrician", "Apprentice", "Foreman" — their trade in
  // their own words, not a pick list.
  role           String?
  hourlyRateCents Int?
  dailyRateCents  Int?
  phone          String?
  email          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  timeEntries TimeEntry[]

  @@index([organizationId, active])
  @@index([crewId])
}

// Time on a job: hours, days, or both on the same row — three days plus
// four hours of overtime is one entry, not two. The rates are copied onto
// the row when it is logged, so raising a crew's rate never rewrites what
// last month cost.
model TimeEntry {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Which scope of work it was against. Null lands it on the whole job.
  scopeId        String?
  scope          ProjectScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  crewId         String?
  crew           Crew?         @relation(fields: [crewId], references: [id], onDelete: SetNull)
  workerId       String?
  worker         Worker?       @relation(fields: [workerId], references: [id], onDelete: SetNull)
  // Who it was, as text, so the row still reads after a crew or worker is
  // deleted.
  workerName     String
  workedOn       DateTime      @db.Date
  hours          Float         @default(0)
  days           Float         @default(0)
  hourlyRateCents Int          @default(0)
  dailyRateCents  Int          @default(0)
  // hours × hourly + days × daily, rounded once and stored, so a total is
  // a sum and never a recomputation.
  amountCents    Int           @default(0)
  // False for a subcontractor's hours, whose money arrives as their
  // purchase order instead. Tracked either way; only ever counted once.
  countsAsCost   Boolean       @default(true)
  // The day it was paid out. Set one row at a time, or in bulk by
  // "Mark paid through". Unpaid time is Committed; paid time is Spent.
  paidOn         DateTime?     @db.Date
  note           String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, workedOn])
  @@index([projectId, workedOn])
  @@index([scopeId])
  @@index([crewId, workedOn])
  @@index([workerId])
}

// The workspace's event-type list, same shape as its service types and
// contract types: stored by name on the event, so renaming an option is
// a label change and never a migration.
model EventTypeOption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A day on the calendar: an install day, a site walk, a construction
// meeting with the owner's team, a delivery, an inspection.
//
// Dates are days, not moments. A day of work is a day wherever you read
// it from, so startOn/endOn are date-only and the times beside them are
// optional strings — "07:30" — kept in the workspace's own clock. That
// keeps a 7:30am install reading 7:30am and avoids a whole class of
// time-zone bugs on the thing people look at most.
model CalendarEvent {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  // One of the workspace's EventTypeOption names.
  type           String
  startOn        DateTime      @db.Date
  // The last day of a multi-day event, inclusive. Null means one day.
  endOn          DateTime?     @db.Date
  // "07:30" and "16:00", or null for a day with no clock on it.
  startTime      String?
  endTime        String?
  // Where it happens. Defaults to the job's site address when there is
  // one, and stays editable — the walk-through is sometimes at their
  // office, not the site.
  location       String?
  notes          String        @default("")
  // What it belongs to. All optional: a site walk can exist before there
  // is a job, and a lunch with a contact belongs to nothing at all.
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeId        String?
  scope          ProjectScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Who is going. The crew doing the work, plus anyone else expected —
  // the property manager, the homeowner, the owner's superintendent.
  crewId         String?
  crew           Crew?         @relation(fields: [crewId], references: [id], onDelete: SetNull)
  attendees      Contact[]     @relation("EventAttendees")
  // Ticked off when the day is done, so a week reads at a glance.
  doneAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, startOn])
  @@index([projectId])
  @@index([crewId, startOn])
  @@index([contactId])
  @@index([companyId])
  @@index([scopeId])
  @@index([dealId])
}

// A thing to do on a job, with an optional day it is wanted by. Kept
// deliberately thin: a checklist, not a project-management tool.
model ProjectTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  dueOn          DateTime?    @db.Date
  doneAt         DateTime?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId, doneAt])
  @@index([organizationId, dueOn])
}

// A building, with the jobs done at it. A property manager with four
// towers wants the roll-up per tower, not per job: what was awarded
// across every job there, what has been spent, what is still owed.
//
// A job belongs to at most one property, which is what keeps the roll-up
// honest — the same money can never be counted under two buildings.
// Which stages count is chosen on the screen, not stored: cancelled work
// is money that never happened, and whether delayed work belongs in the
// total is a judgement the person looking makes.
model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  state          String?
  // Who owns or manages it. Both optional: a property can exist before
  // anybody at it is in the CRM.
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects Project[]

  @@index([organizationId, name])
  @@index([companyId])
  @@index([contactId])
}
